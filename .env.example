# --- Database (PostgreSQL 14+) ---
DATABASE_URL=postgres://devparth:devparth@localhost:5432/devparth_archive

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_NAME="Dev Parth — Poetry Archive"

# --- Auth (generate with: openssl rand -base64 48) ---
AUTH_SECRET=change-me-to-a-long-random-string
# Initial admin created by `npm run db:seed` if no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME="Dev Parth"

# --- Storage (local disk by default; S3/R2 optional) ---
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./public/media
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Optional AI (disabled unless set). Never modifies poems. ---
AI_PROVIDER=none                # none | openai-compatible
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Optional Redis (rate limiting / caching). In-memory fallback if empty. ---
REDIS_URL=

# --- Observability ---
LOG_LEVEL=info                  # debug | info | warn | error

# --- Scheduled publishing: `GET /api/v1/admin/cron/publish` with `Authorization: Bearer $CRON_SECRET` ---
CRON_SECRET=
